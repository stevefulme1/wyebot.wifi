{
  "uid": "wyebot-alerts",
  "title": "Wyebot - Alerts",
  "description": "Wyebot WiFi sensor alert history and active alert status",
  "tags": ["wyebot", "alerts"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Data Source"
      },
      {
        "name": "sensor",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(wyebot_sensor_info, sensor_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "label": "Sensor"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Alerts",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "count(wyebot_alert_active{sensor_name=~\"$sensor\"} == 1) or vector(0)",
          "legendFormat": "Active",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "color": {"mode": "thresholds"},
          "unit": "none",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "Alert History",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(wyebot_alerts_total{sensor_name=~\"$sensor\"}[15m])) by (severity)",
          "legendFormat": "{{severity}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {"mode": "normal"}
          },
          "unit": "ops",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "critical"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          },
          {
            "matcher": {"id": "byName", "options": "warning"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]
          },
          {
            "matcher": {"id": "byName", "options": "info"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]
          }
        ]
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 3,
      "title": "Alert Details",
      "type": "table",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "wyebot_alert_active{sensor_name=~\"$sensor\"} == 1",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "auto", "filterable": true},
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "severity"},
            "properties": [{"id": "custom.displayMode", "value": "color-text"}]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {"show": false},
        "sortBy": [{"displayName": "severity", "desc": true}]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "Value": true}
          }
        }
      ]
    }
  ]
}
