{
  "uid": "wyebot-sensor-overview",
  "title": "Wyebot - Sensor Overview",
  "description": "Overview of Wyebot WiFi sensor status, health, network tests, and uptime",
  "tags": ["wyebot", "sensor", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Data Source"
      },
      {
        "name": "sensor",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(wyebot_sensor_info, sensor_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "label": "Sensor"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Sensors Online",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "count(wyebot_sensor_status{sensor_name=~\"$sensor\"} == 1)",
          "legendFormat": "Online",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 1},
              {"color": "green", "value": 5}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": [],
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Sensors Offline",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "count(wyebot_sensor_status{sensor_name=~\"$sensor\"} == 0) or vector(0)",
          "legendFormat": "Offline",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 3}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": [],
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Sensor Health Score",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "avg(wyebot_sensor_health_score{sensor_name=~\"$sensor\"})",
          "legendFormat": "Avg Health",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 50},
              {"color": "yellow", "value": 70},
              {"color": "green", "value": 85}
            ]
          },
          "color": {"mode": "thresholds"},
          "min": 0,
          "max": 100,
          "unit": "percent",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "title": "Network Test Results",
      "type": "table",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "wyebot_network_test_result{sensor_name=~\"$sensor\"}",
          "legendFormat": "{{sensor_name}} - {{test_type}} - {{ssid}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "FAIL", "color": "red"}}},
            {"type": "value", "options": {"1": {"text": "PASS", "color": "green"}}}
          ]
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {"id": "custom.displayMode", "value": "color-text"},
              {"id": "displayName", "value": "Result"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "sensor_name"},
            "properties": [
              {"id": "displayName", "value": "Sensor"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "test_type"},
            "properties": [
              {"id": "displayName", "value": "Test"}
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {"show": false},
        "sortBy": [{"displayName": "Sensor", "desc": false}]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Sensor Uptime",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "wyebot_sensor_uptime_seconds{sensor_name=~\"$sensor\"} / 3600",
          "legendFormat": "{{sensor_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Hours",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {"mode": "none"}
          },
          "unit": "h",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}
      }
    }
  ]
}
